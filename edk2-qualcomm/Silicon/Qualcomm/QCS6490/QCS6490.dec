[Defines]
  DEC_SPECIFICATION              = 0x0001001B
  PACKAGE_NAME                   = QCS6490
  PACKAGE_GUID                   = 0aeb376a-9528-4f4b-93cb-ebf4c47937c4
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

  #
  # For the device trees built from devicetree-rebasing (resolved through
  # PACKAGES_PATH, like the Rockchip boards do).
  #
  devicetree/mainline/upstream/include

[Guids.common]
  gQcs6490TokenSpaceGuid = { 0xb1807de8, 0xa80e, 0x4fcd, { 0xba, 0x44, 0xfd, 0x98, 0xcb, 0x27, 0x9e, 0x4e } }

  #
  # Vendor GUID of the platform settings variables, and of the Platform
  # Configuration formset. Include/Guid/Qcs6490PlatformConfig.h
  #
  gQcs6490PlatformConfigGuid = { 0xe2442d08, 0x80fa, 0x478e, { 0x8c, 0x24, 0x88, 0x38, 0xb4, 0x5f, 0x8d, 0xa9 } }

[Protocols.common]
  #
  # Installed (with no interface) once SmmuDxe has set up the streams of the
  # devices UEFI does DMA with.
  #
  gQcs6490SmmuReadyProtocolGuid = { 0xfc576c2b, 0xcb3c, 0x44ec, { 0x82, 0x5a, 0xea, 0xdc, 0x52, 0xdc, 0xcb, 0x69 } }

[PcdsFixedAtBuild.common]
  #
  # The exception level when neither the HypervisorMode setting (EL1 or EL2)
  # nor xbl_config's OsConfigTableSelection decides it (see
  # Include/Guid/Qcs6490PlatformConfig.h). TRUE asks TrustZone to tear down
  # the Gunyah hypervisor and continue at EL2, as the upstream RB3 Gen 2 port
  # does; FALSE keeps UEFI and the OS at EL1 as a Gunyah guest.
  #
  gQcs6490TokenSpaceGuid.PcdExitGunyah|FALSE|BOOLEAN|0x00000001

  #
  # DRAM described from PcdSystemMemoryBase when the RAM partition table XBL
  # leaves in SMEM cannot be read.
  #
  gQcs6490TokenSpaceGuid.PcdFallbackSystemMemorySize|0x80000000|UINT64|0x00000002

  #
  # QUP serial engines to load protocol firmware into, from the qupfw_a
  # partition: one UINT32 per engine, its base address OR'ed with the protocol
  # the board's device tree gives it (1 SPI, 2 UART, 3 I2C). Ends at 0.
  #
  gQcs6490TokenSpaceGuid.PcdQupFwSerialEngines|{ 0x0 }|VOID*|0x00000003

  #
  # HDMI output through an LT9611 MIPI DSI to HDMI bridge on DSI0
  # (MdssDisplayDxe). Off unless the board describes the bridge.
  #
  gQcs6490TokenSpaceGuid.PcdDisplayEnable|FALSE|BOOLEAN|0x00000010

  #
  # How the LT9611 is wired: its 7-bit I2C address, the GPIOs of its I2C bus
  # (driven as GPIOs by UEFI) and the TLMM function they go back to for the
  # OS, its reset and 3.3 V enable GPIOs, and whether its MIPI input is on
  # port B.
  #
  gQcs6490TokenSpaceGuid.PcdLt9611I2cAddress|0x39|UINT8|0x00000011
  gQcs6490TokenSpaceGuid.PcdLt9611SdaGpio|0|UINT16|0x00000012
  gQcs6490TokenSpaceGuid.PcdLt9611SclGpio|0|UINT16|0x00000013
  gQcs6490TokenSpaceGuid.PcdLt9611I2cPinFunction|0|UINT8|0x00000014
  gQcs6490TokenSpaceGuid.PcdLt9611ResetGpio|0|UINT16|0x00000015
  gQcs6490TokenSpaceGuid.PcdLt9611PowerGpio|0|UINT16|0x00000016
  gQcs6490TokenSpaceGuid.PcdLt9611PortB|FALSE|BOOLEAN|0x00000017

  #
  # Where the UEFI variable store lives on UFS: the LUN and the GPT partition
  # name (a UTF-16 string). SEC reads it into memory at
  # PcdFlashNvStorageVariableBase64, the FVB driver writes changes back.
  # An empty name keeps the variables in memory only. See
  # Include/Qcs6490NvStore.h.
  #
  gQcs6490TokenSpaceGuid.PcdNvStoreUfsLun|0|UINT8|0x00000020
  gQcs6490TokenSpaceGuid.PcdNvStorePartitionName|L""|VOID*|0x00000021
