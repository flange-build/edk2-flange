[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Qcs6490GunyahExitDxe
  FILE_GUID                      = d8361807-10fb-4a7f-a6c2-0efe3759f689
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = GunyahExitDxeInitialize

[Sources]
  GunyahExit.h
  GunyahExitDxe.c

[Sources.AARCH64]
  AArch64/GunyahExit.S

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Silicon/Qualcomm/QCS6490/QCS6490.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  PrintLib
  Qcs6490NvStatusLib
  SerialPortLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gQcs6490GunyahExitProtocolGuid    ## PRODUCES
  gQcs6490SmmuProtocolGuid          ## SOMETIMES_CONSUMES

[FixedPcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdSerialRegisterBase

[Depex]
  TRUE
