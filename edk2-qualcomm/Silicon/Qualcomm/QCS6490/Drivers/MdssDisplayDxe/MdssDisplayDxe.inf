[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Qcs6490MdssDisplayDxe
  FILE_GUID                      = adcc5751-511b-4ce0-89ae-c01f118c49aa
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = MdssDisplayDxeInitialize

[Sources]
  Diag.c
  Dpu.c
  Dsi.c
  Dsi.h
  DsiPhy.c
  Edid.c
  Gop.c
  Gop.h
  GpioI2c.c
  Lt9611.c
  Lt9611Internal.h
  MdssDisplay.h
  MdssDisplayDxe.c
  MdssPower.h
  Power.c
  Tlmm.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Qualcomm/QCS6490/QCS6490.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  FrameBufferBltLib
  IoLib
  MemoryAllocationLib
  PcdLib
  Qcs6490RpmhLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiCpuArchProtocolGuid                       ## CONSUMES
  gEfiDevicePathProtocolGuid                    ## PRODUCES
  gEfiEdidActiveProtocolGuid                    ## SOMETIMES_PRODUCES
  gEfiEdidDiscoveredProtocolGuid                ## SOMETIMES_PRODUCES
  gEfiGraphicsOutputProtocolGuid                ## PRODUCES
  gQcs6490SmmuProtocolGuid                      ## SOMETIMES_CONSUMES

[Guids]
  gEfiEventBeforeExitBootServicesGuid           ## CONSUMES ## Event

[FixedPcd]
  gQcs6490TokenSpaceGuid.PcdDisplayEnable
  gQcs6490TokenSpaceGuid.PcdDisplayHandoff
  gQcs6490TokenSpaceGuid.PcdLt9611I2cAddress
  gQcs6490TokenSpaceGuid.PcdLt9611SdaGpio
  gQcs6490TokenSpaceGuid.PcdLt9611SclGpio
  gQcs6490TokenSpaceGuid.PcdLt9611I2cPinFunction
  gQcs6490TokenSpaceGuid.PcdLt9611ResetGpio
  gQcs6490TokenSpaceGuid.PcdLt9611PowerGpio
  gQcs6490TokenSpaceGuid.PcdLt9611PortB

[Depex]
  gEfiCpuArchProtocolGuid AND gQcs6490SmmuReadyProtocolGuid
