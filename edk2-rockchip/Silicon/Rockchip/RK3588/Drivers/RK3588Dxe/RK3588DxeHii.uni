#string STR_CPU_PERF_CLUSTER_VOLTAGES_SUBTITLE             #language en-US "Cluster Voltages"
                                                           #language zh-Hans "\wide簇电压\narrow"

#string STR_CPU_PERF_CPUL_CLUSTER_VOLTAGE_MODE_PROMPT      #language en-US "CPUL Voltage Mode"
                                                           #language zh-Hans "CPUL \wide电压模式\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_VOLTAGE_MODE_HELP        #language en-US "Voltage mode for the Arm LITTLE cores (Cortex-A55) cluster.\n\n Automatic = voltage is set according to predefined OPP table.\n Custom = voltage is user-controlled, affecting clock rate too due to PVTPLL."
                                                           #language zh-Hans "Arm \wide小核（\narrowCortex-A55\wide）簇的电压模式。\narrow\n\n \wide自动\narrow = \wide根据预定义的\narrow OPP \wide表设置电压。\narrow\n \wide自定义\narrow = \wide由用户控制电压；由于\narrow PVTPLL \wide机制，时钟频率也会随之改变。\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_VOLTAGE_CUSTOM_PROMPT    #language en-US "CPUL Custom Volt (uV)"
                                                           #language zh-Hans "CPUL \wide自定义电压（\narrowuV\wide）\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_VOLTAGE_CUSTOM_HELP      #language en-US "Custom regulator voltage for the Arm LITTLE cores (Cortex-A55) cluster.\n\nUse +/- keys to increment/decrement value by the predefined step.\n\nWARNING! Higher custom voltage may cause system instability and excessive heat."
                                                           #language zh-Hans "Arm \wide小核（\narrowCortex-A55\wide）簇的自定义稳压器输出电压。\narrow\n\n\wide使用\narrow +/- \wide键按预设步长增大或减小数值。\narrow\n\n\wide警告：较高的自定义电压可能导致系统不稳定和过度发热。\narrow"

#string STR_CPU_PERF_CPUB01_CLUSTER_VOLTAGE_MODE_PROMPT    #language en-US "CPUB01 Voltage Mode"
                                                           #language zh-Hans "CPUB01 \wide电压模式\narrow"
#string STR_CPU_PERF_CPUB01_CLUSTER_VOLTAGE_CUSTOM_PROMPT  #language en-US "CPUB01 Custom Volt (uV)"
                                                           #language zh-Hans "CPUB01 \wide自定义电压（\narrowuV\wide）\narrow"

#string STR_CPU_PERF_CPUB23_CLUSTER_VOLTAGE_MODE_PROMPT    #language en-US "CPUB23 Voltage Mode"
                                                           #language zh-Hans "CPUB23 \wide电压模式\narrow"
#string STR_CPU_PERF_CPUB23_CLUSTER_VOLTAGE_CUSTOM_PROMPT  #language en-US "CPUB23 Custom Volt (uV)"
                                                           #language zh-Hans "CPUB23 \wide自定义电压（\narrowuV\wide）\narrow"

#string STR_CPU_PERF_CPUB_CLUSTER_VOLTAGE_MODE_HELP        #language en-US "Voltage mode for the selected Arm big cores (Cortex-A76) cluster.\n\n Automatic = voltage is set according to predefined OPP table.\n Custom = voltage is user-controlled, affecting clock rate too due to PVTPLL."
                                                           #language zh-Hans "\wide所选\narrow Arm \wide大核（\narrowCortex-A76\wide）簇的电压模式。\narrow\n\n \wide自动\narrow = \wide根据预定义的\narrow OPP \wide表设置电压。\narrow\n \wide自定义\narrow = \wide由用户控制电压；由于\narrow PVTPLL \wide机制，时钟频率也会随之改变。\narrow"
#string STR_CPU_PERF_CPUB_CLUSTER_VOLTAGE_CUSTOM_HELP      #language en-US "Custom regulator voltage for the selected Arm big cores (Cortex-A76) cluster.\n\nUse +/- keys to increment/decrement value by the predefined step.\n\nWARNING! Higher custom voltage may cause system instability and excessive heat."
                                                           #language zh-Hans "\wide所选\narrow Arm \wide大核（\narrowCortex-A76\wide）簇的自定义稳压器输出电压。\narrow\n\n\wide使用\narrow +/- \wide键按预设步长增大或减小数值。\narrow\n\n\wide警告：较高的自定义电压可能导致系统不稳定和过度发热。\narrow"

#string STR_CPU_PERF_CLUSTER_VOLTAGE_MODE_AUTO             #language en-US "Automatic"
                                                           #language zh-Hans "\wide自动\narrow"
#string STR_CPU_PERF_CLUSTER_VOLTAGE_MODE_CUSTOM           #language en-US "Custom"
                                                           #language zh-Hans "\wide自定义\narrow"

/*
 * PCIe/SATA/USB Combo PIPE PHY configuration
 */
#string STR_COMBO_PHY_FORM_TITLE                           #language en-US "PCIe/SATA/USB Combo PIPE PHY"
                                                           #language zh-Hans  "PCIe/SATA/USB Combo PIPE PHY"
#string STR_COMBO_PHY_FORM_HELP                            #language en-US "Configure the Combo PIPE PHY operation modes."
                                                           #language zh-Hans "\wide配置\narrow Combo PIPE PHY \wide的工作模式。\narrow"
#string STR_COMBO_PHY_FORM_SUBTITLE                        #language en-US "Note: the selected mode must match the interface of the connected device."
                                                           #language zh-Hans "\wide注意：所选模式必须与所连接设备的接口相符。\narrow"

#string STR_COMBO_PHY0_MODE_PROMPT                         #language en-US "PHY #0 Mode"
                                                           #language zh-Hans "PHY #0 \wide模式\narrow"
#string STR_COMBO_PHY1_MODE_PROMPT                         #language en-US "PHY #1 Mode"
                                                           #language zh-Hans "PHY #1 \wide模式\narrow"
#string STR_COMBO_PHY2_MODE_PROMPT                         #language en-US "PHY #2 Mode"
                                                           #language zh-Hans "PHY #2 \wide模式\narrow"

#string STR_COMBO_PHY_MODE_UNCONNECTED                     #language en-US "Unconnected"
                                                           #language zh-Hans "\wide未连接\narrow"
#string STR_COMBO_PHY_MODE_PCIE                            #language en-US "PCIe 2.1 x1"
                                                           #language zh-Hans  "PCIe 2.1 x1"
#string STR_COMBO_PHY_MODE_SATA                            #language en-US "SATA 3.1"
                                                           #language zh-Hans  "SATA 3.1"
#string STR_COMBO_PHY_MODE_USB3                            #language en-US "USB 3.1 Gen 1"
                                                           #language zh-Hans  "USB 3.1 Gen 1"

#string STR_COMBO_PHY_MODE_DEFAULT_UNCONNECTED_HELP        #language en-US "This PHY may not be wired to any slot or device."
                                                           #language zh-Hans "\wide此\narrow PHY \wide可能未连接到任何插槽或设备。\narrow"
#string STR_COMBO_PHY_MODE_DEFAULT_PCIE_HELP               #language en-US "This PHY may be wired to an M.2 or Mini PCIe slot.\n\nConsult your platform's documentation for details on potential alternate modes, such as SATA or USB."
                                                           #language zh-Hans "\wide此\narrow PHY \wide可能连接到\narrow M.2 \wide或\narrow Mini PCIe \wide插槽。\narrow\n\n\wide有关可能的其他模式（如\narrow SATA \wide或\narrow USB\wide）的详细信息，请参阅平台文档。\narrow"
#string STR_COMBO_PHY_MODE_DEFAULT_SATA_HELP               #language en-US "This PHY may be wired to a SATA or M.2 slot.\n\nConsult your platform's documentation for details on potential alternate modes, such as PCIe or USB."
                                                           #language zh-Hans "\wide此\narrow PHY \wide可能连接到\narrow SATA \wide或\narrow M.2 \wide插槽。\narrow\n\n\wide有关可能的其他模式（如\narrow PCIe \wide或\narrow USB\wide）的详细信息，请参阅平台文档。\narrow"
#string STR_COMBO_PHY_MODE_DEFAULT_USB3_HELP               #language en-US "This PHY is wired to an USB 3.1 Gen 1 Type-A port.\n\nConsult your platform's documentation for details on potential alternate modes, such as PCIe or SATA (via non-standard adapters)."
                                                           #language zh-Hans "\wide此\narrow PHY \wide连接到\narrow USB 3.1 Gen 1 Type-A \wide接口。\narrow\n\n\wide有关可能的其他模式（如通过非标准转接器使用\narrow PCIe \wide或\narrow SATA\wide）的详细信息，请参阅平台文档。\narrow"

/*
 * USB/DP Combo PHY configuration
 */
#string STR_USBDP_PHY_FORM_TITLE                           #language en-US "USB/DP Combo PHY"
                                                           #language zh-Hans  "USB/DP Combo PHY"
#string STR_USBDP_PHY_FORM_HELP                            #language en-US "Configure the USB/DP Combo PHY operation modes."
                                                           #language zh-Hans "\wide配置\narrow USB/DP Combo PHY \wide的工作模式。\narrow"

#string STR_USBDP_PHY0_USB3_STATE_PROMPT                   #language en-US "PHY #0 USB 3 SuperSpeed State"
                                                           #language zh-Hans "PHY #0 USB 3 \wide超高速状态\narrow"
#string STR_USBDP_PHY1_USB3_STATE_PROMPT                   #language en-US "PHY #1 USB 3 SuperSpeed State"
                                                           #language zh-Hans "PHY #1 USB 3 \wide超高速状态\narrow"
#string STR_USBDP_PHY_USB3_STATE_PROMPT                    #language en-US "Enable or disable SuperSpeed signaling on the selected PHY.\n\nIf USB 3.0 devices connected to the associated Type-C or Type-A port malfunction, disabling this option may help."
                                                           #language zh-Hans "\wide启用或禁用所选\narrow PHY \wide上的超高速（\narrowSuperSpeed\wide）信号传输。\narrow\n\n\wide如果连接到相应\narrow Type-C \wide或\narrow Type-A \wide接口的\narrow USB 3.0 \wide设备工作异常，禁用此选项可能会有帮助。\narrow"

/*
 * PCI Express 3.0 configuration
 */
#string STR_PCIE30_FORM_TITLE                              #language en-US "PCI Express 3.0"
                                                           #language zh-Hans  "PCI Express 3.0"
#string STR_PCIE30_FORM_HELP                               #language en-US "Configure the PCIe 3.0 operation modes."
                                                           #language zh-Hans "\wide配置\narrow PCIe 3.0 \wide的工作模式。\narrow"

#string STR_PCIE30_STATE_PROMPT                            #language en-US "Support State"
                                                           #language zh-Hans "\wide支持状态\narrow"
#string STR_PCIE30_STATE_HELP                              #language en-US "Enable or disable PCIe 3.0 support."
                                                           #language zh-Hans "\wide启用或禁用\narrow PCIe 3.0 \wide支持。\narrow"

#string STR_PCIE30_PHY_MODE_PROMPT                         #language en-US "PHY Mode"
                                                           #language zh-Hans "PHY \wide模式\narrow"
#string STR_PCIE30_PHY_MODE_HELP                           #language en-US "Choose PHY Mode\n\nx4:\n    4l -> PCIe3 PHY lane 0123\n    2l -> Not connected\n    1l0 -> Combo PHY #1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx2 x2:\n    4l -> PCIe3 PHY lane 01\n    2l -> PCIe3 PHY lane 23\n    1l0 -> Combo PHY #1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx1x1 x2:\n    4l -> PCIe3 PHY lane 0\n    2l -> PCIe3 PHY lane 23\n    1l0 -> PCIe3 PHY lane 1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx2 x1x1:\n    4l -> PCIe3 PHY lane 01\n    2l -> PCIe3 PHY lane 2\n    1l0 -> Combo PHY #1\n    1l1 -> PCIe3 PHY lane 3\n    1l2 -> Combo PHY #0\n\nx1x1 x1x1:\n    4l -> PCIe3 PHY lane 0\n    2l -> PCIe3 PHY lane 2\n    1l0 -> PCIe3 PHY lane 1\n    1l1 -> PCIe3 PHY lane 3\n    1l2 -> Combo PHY #0\n"
                                                           #language zh-Hans "\wide选择\narrow PHY \wide模式\narrow\n\nx4:\n    4l -> PCIe3 PHY \wide通道\narrow 0123\n    2l -> \wide未连接\narrow\n    1l0 -> Combo PHY #1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx2 x2:\n    4l -> PCIe3 PHY \wide通道\narrow 01\n    2l -> PCIe3 PHY \wide通道\narrow 23\n    1l0 -> Combo PHY #1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx1x1 x2:\n    4l -> PCIe3 PHY \wide通道\narrow 0\n    2l -> PCIe3 PHY \wide通道\narrow 23\n    1l0 -> PCIe3 PHY \wide通道\narrow 1\n    1l1 -> Combo PHY #2\n    1l2 -> Combo PHY #0\n\nx2 x1x1:\n    4l -> PCIe3 PHY \wide通道\narrow 01\n    2l -> PCIe3 PHY \wide通道\narrow 2\n    1l0 -> Combo PHY #1\n    1l1 -> PCIe3 PHY \wide通道\narrow 3\n    1l2 -> Combo PHY #0\n\nx1x1 x1x1:\n    4l -> PCIe3 PHY \wide通道\narrow 0\n    2l -> PCIe3 PHY \wide通道\narrow 2\n    1l0 -> PCIe3 PHY \wide通道\narrow 1\n    1l1 -> PCIe3 PHY \wide通道\narrow 3\n    1l2 -> Combo PHY #0\n"
#string STR_PCIE30_PHY_MODE_AGGREGATION                    #language en-US "x4"
                                                           #language zh-Hans  "x4"
#string STR_PCIE30_PHY_MODE_NANBNB                         #language en-US "x2 x2"
                                                           #language zh-Hans  "x2 x2"
#string STR_PCIE30_PHY_MODE_NANBBI                         #language en-US "x1x1 x2"
                                                           #language zh-Hans  "x1x1 x2"
#string STR_PCIE30_PHY_MODE_NABINB                         #language en-US "x2 x1x1"
                                                           #language zh-Hans  "x2 x1x1"
#string STR_PCIE30_PHY_MODE_NABIBI                         #language en-US "x1x1 x1x1"
                                                           #language zh-Hans  "x1x1 x1x1"

/*
 * ACPI / Device Tree configuration
 */
#string STR_CONFIG_TABLE_FORM_TITLE                        #language en-US "ACPI / Device Tree"
                                                           #language zh-Hans "ACPI / \wide设备树\narrow"
#string STR_CONFIG_TABLE_FORM_HELP                         #language en-US "Configure the ACPI and Device Tree system tables support."
                                                           #language zh-Hans "\wide配置\narrow ACPI \wide和设备树系统表支持。\narrow"

#string STR_CONFIG_TABLE_MODE_PROMPT                       #language en-US "Config Table Mode"
                                                           #language zh-Hans "\wide配置表模式\narrow"
#string STR_CONFIG_TABLE_MODE_HELP                         #language en-US "Choose what config tables to expose to the OS.\n\n"
                                                                           "ACPI - provides basic hardware support (USB, PCIe, SATA) for most OS/kernel versions, such as Windows, BSD, VMware ESXi. It is not recommended for Linux usage; please use a recent kernel with Device Tree instead.\n\n"
                                                                           "Device Tree - provides extensive hardware support specific to a kernel variant.\nDepending on the platform, the firmware may include DTBs compatible with either the Rockchip SDK Linux kernel or the generic mainline/upstream kernels.\n\nIf both options are exposed, the OS will decide which one to use. Linux prefers DT, while Windows will only use ACPI."
                                                           #language zh-Hans "\wide选择向操作系统提供哪些配置表。\narrow\n\n"
                                                                             "ACPI - \wide为大多数操作系统\narrow/\wide内核版本（如\narrow Windows\wide、\narrowBSD\wide、\narrowVMware ESXi\wide）提供基本的硬件支持（\narrowUSB\wide、\narrowPCIe\wide、\narrowSATA\wide）。不建议在\narrow Linux \wide下使用，请改用较新的内核并搭配设备树。\narrow\n\n"
                                                                             "\wide设备树\narrow - \wide提供针对特定内核分支的全面硬件支持。\narrow\n\wide根据平台不同，固件可能包含与\narrow Rockchip SDK Linux \wide内核或通用主线\narrow/\wide上游内核兼容的\narrow DTB\wide。\narrow\n\n\wide如果同时提供两者，由操作系统决定使用哪一种。\narrowLinux \wide优先使用设备树，而\narrow Windows \wide只会使用\narrow ACPI\wide。\narrow"
#string STR_CONFIG_TABLE_MODE_ACPI                         #language en-US "ACPI"
                                                           #language zh-Hans  "ACPI"
#string STR_CONFIG_TABLE_MODE_FDT                          #language en-US "Device Tree"
                                                           #language zh-Hans "\wide设备树\narrow"
#string STR_CONFIG_TABLE_MODE_ACPI_FDT                     #language en-US "Both"
                                                           #language zh-Hans "\wide两者\narrow"

#string STR_CONFIG_TABLE_ACPI_SUBTITLE                     #language en-US "ACPI Configuration"
                                                           #language zh-Hans "ACPI \wide配置\narrow"

#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_PROMPT              #language en-US "PCIe ECAM Compatibility Mode"
                                                           #language zh-Hans "PCIe ECAM \wide兼容模式\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_HELP                #language en-US "Choose how to expose the non-standard PCIe configuration space to the OS.\n\n"
                                                                           "Single Device - compatible with all OSes. Allows usage of a single or multi-function device. Switches are not supported.\n\n"
                                                                           "NXPMX6 - compatible with Windows. Switches are supported.\n\n"
                                                                           "AMAZON GRAVITON - compatible with Linux. Switches are supported.\n\n"
                                                                           "The Auto mode selects NXPMX6 for Windows, AMAZON GRAVTION for Linux or Single Device for other OSes."
                                                           #language zh-Hans "\wide选择如何向操作系统提供非标准的\narrow PCIe \wide配置空间。\narrow\n\n"
                                                                             "\wide单设备\narrow - \wide兼容所有操作系统。可使用单个设备或多功能设备，不支持\narrow PCIe \wide交换机。\narrow\n\n"
                                                                             "NXPMX6 - \wide兼容\narrow Windows\wide。支持\narrow PCIe \wide交换机。\narrow\n\n"
                                                                             "AMAZON GRAVITON - \wide兼容\narrow Linux\wide。支持\narrow PCIe \wide交换机。\narrow\n\n"
                                                                             "\wide自动模式下，\narrowWindows \wide使用\narrow NXPMX6\wide，\narrowLinux \wide使用\narrow AMAZON GRAVITON\wide，其他操作系统使用单设备。\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_AUTO                #language en-US "Auto"
                                                           #language zh-Hans "\wide自动\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_SINGLE_DEV          #language en-US "Single Device"
                                                           #language zh-Hans "\wide单设备\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_NXPMX6              #language en-US "NXPMX6"
                                                           #language zh-Hans  "NXPMX6"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_GRAVITON            #language en-US "AMAZON GRAVITON"
                                                           #language zh-Hans  "AMAZON GRAVITON"

#string STR_CONFIG_TABLE_FDT_SUBTITLE                      #language en-US "Device Tree Configuration"
                                                           #language zh-Hans "\wide设备树配置\narrow"

#string STR_FDT_COMPAT_MODE_PROMPT                         #language en-US "Compatibility Mode"
                                                           #language zh-Hans "\wide兼容模式\narrow"
#string STR_FDT_COMPAT_MODE_HELP                           #language en-US "Choose what Device Tree to expose to the OS.\n\n"
                                                                           "Vendor - compatible with Rockchip SDK Linux 6.1 kernel only.\n\n"
                                                                           "Mainline - compatible with generic upstream Linux 6.10 or newer kernel. This option is under active development and may lack certain features. Therefore, it is always recommended to use the latest kernel and firmware available in order to benefit from better device support."
                                                           #language zh-Hans "\wide选择向操作系统提供哪种设备树。\narrow\n\n"
                                                                             "\wide厂商\narrow - \wide仅兼容\narrow Rockchip SDK Linux 6.1 \wide内核。\narrow\n\n"
                                                                             "\wide主线\narrow - \wide兼容通用上游\narrow Linux 6.10 \wide或更新版本的内核。此选项仍在积极开发中，可能缺少部分功能。因此，始终建议使用可获得的最新内核和固件，以获得更好的设备支持。\narrow"
#string STR_FDT_COMPAT_MODE_VENDOR                         #language en-US "Vendor"
                                                           #language zh-Hans "\wide厂商\narrow"
#string STR_FDT_COMPAT_MODE_MAINLINE                       #language en-US "Mainline"
                                                           #language zh-Hans "\wide主线\narrow"

#string STR_FDT_FORCE_GOP_PROMPT                           #language en-US "Force UEFI GOP Display"
                                                           #language zh-Hans "\wide强制\narrow UEFI GOP \wide显示\narrow"
#string STR_FDT_FORCE_GOP_HELP                             #language en-US "This option allows using the basic display output provided by UEFI GOP (HDMI/DP/DSI) on older Linux kernels, which lack native driver support."
                                                           #language zh-Hans "\wide此选项允许在缺少原生驱动支持的旧版\narrow Linux \wide内核上，使用\narrow UEFI GOP \wide提供的基本显示输出（\narrowHDMI/DP/DSI\wide）。\narrow"

#string STR_FDT_SUPPORT_OVERRIDES_PROMPT                   #language en-US "Support DTB override & overlays"
                                                           #language zh-Hans "\wide支持\narrow DTB \wide替换和叠加层\narrow"
#string STR_FDT_SUPPORT_OVERRIDES_HELP                     #language en-US "Enable or disable support for overriding the firmware-provided DTB and installing overlays.\n\nCheck firmware documentation for more details."
                                                           #language zh-Hans "\wide启用或禁用对替换固件自带\narrow DTB \wide以及安装叠加层（\narrowOverlay\wide）的支持。\narrow\n\n\wide详情请参阅固件文档。\narrow"

#string STR_FDT_OVERRIDE_SUBTITLE                          #language en-US "DTB Override"
                                                           #language zh-Hans "DTB \wide替换\narrow"

#string STR_FDT_OVERRIDE_FIXUP_PROMPT                      #language en-US "Firmware Fix-ups"
                                                           #language zh-Hans "\wide固件修正\narrow"
#string STR_FDT_OVERRIDE_FIXUP_HELP                        #language en-US "Enable or disable firmware fix-ups for the DTB override."
                                                           #language zh-Hans "\wide启用或禁用固件对替换\narrow DTB \wide所做的修正。\narrow"

#string STR_FDT_OVERRIDE_BASE_PATH_PROMPT                  #language en-US "Preferred Base DTB Path"
                                                           #language zh-Hans "\wide首选基础\narrow DTB \wide路径\narrow"
#string STR_FDT_OVERRIDE_BASE_PATH_HELP                    #language en-US "Enter the preferred file or directory path for the base DTB override, relative to the file system root.\n\n"
                                                                           "Once a boot device is selected, the firmware will scan all the supported file systems on it (FAT, ext4) and try to load the specified override.\n\n"
                                                                           "- If a directory path is specified, the platform FDT file name will be appended to it (<PLATFORM-DT-NAME>).\n"
                                                                           "- If a file path is specified, it will be used as is.\n"
                                                                           "- If no override exists, the firmware-provided DTB will be used instead.\n\n"
                                                                           "Examples:\n"
                                                                           " \\dtbs\n"
                                                                           " \\dtbs\\my-board.dtb\n\n"
                                                                           "Default alternative paths:\n"
                                                                           " \\dtb\n"
                                                                           " \\dtb\\base\n"
                                                                           " \\dtb\\rockchip\n\n"
                                                                           "To reset this option to the default value, set it to a space character, save and reboot."
                                                           #language zh-Hans "\wide输入用于替换基础\narrow DTB \wide的首选文件或目录路径（相对于文件系统根目录）。\narrow\n\n"
                                                                             "\wide选定启动设备后，固件将扫描该设备上所有受支持的文件系统（\narrowFAT\wide、\narrowext4\wide），并尝试加载指定的替换\narrow DTB\wide。\narrow\n\n"
                                                                             "- \wide如果指定的是目录路径，将在其后追加平台\narrow FDT \wide文件名（\narrow<PLATFORM-DT-NAME>\wide）。\narrow\n"
                                                                             "- \wide如果指定的是文件路径，将按原样使用。\narrow\n"
                                                                             "- \wide如果不存在替换\narrow DTB\wide，则改用固件提供的\narrow DTB\wide。\narrow\n\n"
                                                                             "\wide示例：\narrow\n"
                                                                             " \\dtbs\n"
                                                                             " \\dtbs\\my-board.dtb\n\n"
                                                                             "\wide默认备选路径：\narrow\n"
                                                                             " \\dtb\n"
                                                                             " \\dtb\\base\n"
                                                                             " \\dtb\\rockchip\n\n"
                                                                             "\wide要将此选项恢复为默认值，请将其设为一个空格字符，然后保存并重启。\narrow"

#string STR_FDT_OVERRIDE_OVERLAY_PATH_PROMPT               #language en-US "Preferred Overlays Path"
                                                           #language zh-Hans "\wide首选叠加层路径\narrow"
#string STR_FDT_OVERRIDE_OVERLAY_PATH_HELP                 #language en-US "Enter the preferred directory path for the DTB overlays, relative to the file system root.\n\n"
                                                                           "Once a boot device is selected, the firmware will scan all the supported file systems on it (FAT, ext4) and try to load all overlays in the specified directory.\n\n"
                                                                           "- If the installation of an overlay fails, all other overlays will be discarded.\n\n"
                                                                           "Examples:\n"
                                                                           " \\my-overlays\n"
                                                                           " \\dtbs\\overlays\n\n"
                                                                           "Default alternative paths:\n"
                                                                           " \\dtb\\overlays\n"
                                                                           " \\dtb\\overlays\\<PLATFORM-DT-NAME>\n\n"
                                                                           "To reset this option to the default value, set it to a space character, save and reboot."
                                                           #language zh-Hans "\wide输入\narrow DTB \wide叠加层的首选目录路径（相对于文件系统根目录）。\narrow\n\n"
                                                                             "\wide选定启动设备后，固件将扫描该设备上所有受支持的文件系统（\narrowFAT\wide、\narrowext4\wide），并尝试加载指定目录中的所有叠加层。\narrow\n\n"
                                                                             "- \wide如果任一叠加层安装失败，其余所有叠加层都将被丢弃。\narrow\n\n"
                                                                             "\wide示例：\narrow\n"
                                                                             " \\my-overlays\n"
                                                                             " \\dtbs\\overlays\n\n"
                                                                             "\wide默认备选路径：\narrow\n"
                                                                             " \\dtb\\overlays\n"
                                                                             " \\dtb\\overlays\\<PLATFORM-DT-NAME>\n\n"
                                                                             "\wide要将此选项恢复为默认值，请将其设为一个空格字符，然后保存并重启。\narrow"

