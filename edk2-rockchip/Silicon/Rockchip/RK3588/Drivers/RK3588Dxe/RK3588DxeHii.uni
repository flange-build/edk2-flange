#string STR_DISPLAY_FORCE_OUTPUT_PROMPT                    #language en-US "Force Output"
                                                           #language zh-Hans "\wide强制输出\narrow"
#string STR_DISPLAY_FORCE_OUTPUT_HELP                      #language en-US "Enable or disable the display output even when none is connected.\n\n"
                                                                           "If the serial console is used instead, this option can be disabled to allow OSes to prefer it when possible."
                                                           #language zh-Hans "\wide设置在未连接任何显示器时是否仍启用显示输出。\narrow\n\n"
                                                                             "\wide如果改用串口控制台，可禁用此选项，使操作系统在可能时优先使用串口控制台。\narrow"

#string STR_DISPLAY_DUPLICATE_OUTPUT_PROMPT                #language en-US "Duplicate Primary Display"
                                                           #language zh-Hans "\wide复制主显示器\narrow"
#string STR_DISPLAY_DUPLICATE_OUTPUT_HELP                  #language en-US "Enable or disable duplication of the primary display output on other connected displays.\n"
                                                                           "Note that this will use the same mode/resolution everywhere, even if it is not supported by the other displays."
                                                           #language zh-Hans "\wide启用或禁用在其他已连接的显示器上复制主显示器的输出。\narrow\n"
                                                                             "\wide注意：所有显示器都将使用相同的模式\narrow/\wide分辨率，即使其他显示器不支持该模式。\narrow"

#string STR_DISPLAY_ROTATION_PROMPT                        #language en-US "Rotation"
                                                           #language zh-Hans "\wide旋转\narrow"
#string STR_DISPLAY_ROTATION_HELP                          #language en-US "Choose the display output rotation in degrees.\n\n"
                                                                           "Note: This option only takes effect in the boot environment. If set to a value other than 0, the OS will be unable to use the UEFI GOP service and will require a native display driver."
                                                           #language zh-Hans "\wide选择显示输出的旋转角度（单位：度）。\narrow\n\n"
                                                                             "\wide注意：此选项仅在启动环境中生效。如果设为\narrow 0 \wide以外的值，操作系统将无法使用\narrow UEFI GOP \wide服务，必须使用原生显示驱动程序。\narrow"
#string STR_DISPLAY_ROTATION_0                             #language en-US "0"
                                                           #language zh-Hans  "0"
#string STR_DISPLAY_ROTATION_90                            #language en-US "90"
                                                           #language zh-Hans  "90"
#string STR_DISPLAY_ROTATION_180                           #language en-US "180"
                                                           #language zh-Hans  "180"
#string STR_DISPLAY_ROTATION_270                           #language en-US "270"
                                                           #language zh-Hans  "270"

#string STR_DISPLAY_CONNECTOR_TYPE_HDMI                    #language en-US "HDMI"
                                                           #language zh-Hans  "HDMI"

#string STR_HDMI_SIGNALING_MODE_PROMPT                     #language en-US "Signaling Mode"
                                                           #language zh-Hans "\wide信号模式\narrow"
#string STR_HDMI_SIGNALING_MODE_HELP                       #language en-US "Choose the preferred HDMI signaling mode.\n\n"
                                                                           "Auto - determines mode from the connected display, otherwise falls back to DVI.\n\n"
                                                                           "DVI - disables all data packets. This option may help the display use full range RGB and disable overscan to match the firmware output.\n\n"
                                                                           "HDMI - allows transmission of data packets."
                                                           #language zh-Hans "\wide选择首选的\narrow HDMI \wide信号模式。\narrow\n\n"
                                                                             "\wide自动\narrow - \wide根据所连接的显示器确定模式，无法确定时回退到\narrow DVI\wide。\narrow\n\n"
                                                                             "DVI - \wide禁用所有数据包。此选项可能有助于让显示器使用全范围\narrow RGB \wide并关闭过扫描，以与固件输出保持一致。\narrow\n\n"
                                                                             "HDMI - \wide允许传输数据包。\narrow"
#string STR_HDMI_SIGNALING_MODE_AUTO                       #language en-US "Auto"
                                                           #language zh-Hans "\wide自动\narrow"
#string STR_HDMI_SIGNALING_MODE_DVI                        #language en-US "DVI"
                                                           #language zh-Hans  "DVI"
#string STR_HDMI_SIGNALING_MODE_HDMI                       #language en-US "HDMI"
                                                           #language zh-Hans  "HDMI"

/*
 * CPU Performance configuration
 */
#string STR_CPU_PERF_FORM_TITLE                            #language en-US "CPU Performance"
                                                           #language zh-Hans "CPU \wide性能\narrow"
#string STR_CPU_PERF_FORM_HELP                             #language en-US "Adjust CPU clocks and voltages."
                                                           #language zh-Hans "\wide调整\narrow CPU \wide时钟频率和电压。\narrow"
#string STR_CPU_PERF_FORM_SUBTITLE                         #language en-US "Note: All these settings may be overridden by the OS if supported."
                                                           #language zh-Hans "\wide注意：如果操作系统支持，这些设置都可能被操作系统覆盖。\narrow"

#string STR_CPU_PERF_CLUSTER_CLOCKS_SUBTITLE               #language en-US "Cluster Clocks"
                                                           #language zh-Hans "\wide簇时钟\narrow"

#string STR_CPU_PERF_CPUL_CLUSTER_CLOCK_PRESET_PROMPT      #language en-US "CPUL Clock Preset"
                                                           #language zh-Hans "CPUL \wide时钟预设\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_CLOCK_PRESET_HELP        #language en-US "Clock preset for the Arm LITTLE cores (Cortex-A55) cluster.\n\nBoot default will retain the frequency set by earlier boot stages.\n\nWARNING! Setting Maximum clock rate is NOT recommended without adequate cooling and power supply."
                                                           #language zh-Hans "Arm \wide小核（\narrowCortex-A55\wide）簇的时钟预设。\narrow\n\n\wide选择启动默认值时，将保留先前启动阶段所设置的频率。\narrow\n\n\wide警告：在散热和供电不足的情况下，不建议设为最大时钟频率。\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_CLOCK_CUSTOM_PROMPT      #language en-US "CPUL Custom Clock (MHz)"
                                                           #language zh-Hans "CPUL \wide自定义频率（\narrowMHz\wide）\narrow"
#string STR_CPU_PERF_CPUL_CLUSTER_CLOCK_CUSTOM_HELP        #language en-US "Custom target clock for the Arm LITTLE cores (Cortex-A55) cluster.\n\nNote that the actual frequency will vary with voltage starting from 816 MHz."
                                                           #language zh-Hans "Arm \wide小核（\narrowCortex-A55\wide）簇的自定义目标频率。\narrow\n\n\wide注意：从\narrow 816 MHz \wide起，实际频率将随电压而变化。\narrow"

#string STR_CPU_PERF_CPUB01_CLUSTER_CLOCK_PRESET_PROMPT    #language en-US "CPUB01 Clock Preset"
                                                           #language zh-Hans "CPUB01 \wide时钟预设\narrow"
#string STR_CPU_PERF_CPUB01_CLUSTER_CLOCK_CUSTOM_PROMPT    #language en-US "CPUB01 Custom Clock (MHz)"
                                                           #language zh-Hans "CPUB01 \wide自定义频率（\narrowMHz\wide）\narrow"

#string STR_CPU_PERF_CPUB23_CLUSTER_CLOCK_PRESET_PROMPT    #language en-US "CPUB23 Clock Preset"
                                                           #language zh-Hans "CPUB23 \wide时钟预设\narrow"
#string STR_CPU_PERF_CPUB23_CLUSTER_CLOCK_CUSTOM_PROMPT    #language en-US "CPUB23 Custom Clock (MHz)"
                                                           #language zh-Hans "CPUB23 \wide自定义频率（\narrowMHz\wide）\narrow"

#string STR_CPU_PERF_CPUB_CLUSTER_CLOCK_PRESET_HELP        #language en-US "Clock preset for the selected Arm big cores (Cortex-A76) cluster.\n\nBoot default will retain the frequency set by earlier boot stages.\n\nWARNING! Setting Maximum clock rate is NOT recommended without adequate cooling and power supply."
                                                           #language zh-Hans "\wide所选\narrow Arm \wide大核（\narrowCortex-A76\wide）簇的时钟预设。\narrow\n\n\wide选择启动默认值时，将保留先前启动阶段所设置的频率。\narrow\n\n\wide警告：在散热和供电不足的情况下，不建议设为最大时钟频率。\narrow"
#string STR_CPU_PERF_CPUB_CLUSTER_CLOCK_CUSTOM_HELP        #language en-US "Custom target clock for the selected Arm big cores (Cortex-A76) cluster.\n\nNote that the actual frequency will vary with voltage starting from 816 MHz."
                                                           #language zh-Hans "\wide所选\narrow Arm \wide大核（\narrowCortex-A76\wide）簇的自定义目标频率。\narrow\n\n\wide注意：从\narrow 816 MHz \wide起，实际频率将随电压而变化。\narrow"

#string STR_CPU_PERF_CLUSTER_CLOCK_PRESET_BOOTDEF          #language en-US "Boot default"
                                                           #language zh-Hans "\wide启动默认值\narrow"
#string STR_CPU_PERF_CLUSTER_CLOCK_PRESET_MIN              #language en-US "Minimum"
                                                           #language zh-Hans "\wide最小\narrow"
#string STR_CPU_PERF_CLUSTER_CLOCK_PRESET_MAX              #language en-US "Maximum"
                                                           #language zh-Hans "\wide最大\narrow"
#string STR_CPU_PERF_CLUSTER_CLOCK_PRESET_CUSTOM           #language en-US "Custom"
                                                           #language zh-Hans "\wide自定义\narrow"

