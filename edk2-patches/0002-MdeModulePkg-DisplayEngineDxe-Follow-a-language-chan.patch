   FreePool (gPasswordUnsupported);
 }
 
+/**
+  Register the default hot keys F9 and F10 with the browser, with their help
+  in the current language.
+
+**/
+STATIC
+VOID
+RegisterDefaultHotKeys (
+  VOID
+  )
+{
+  EFI_STATUS                              Status;
+  EFI_INPUT_KEY                           HotKey;
+  EFI_STRING                              NewString;
+  EDKII_FORM_BROWSER_EXTENSION2_PROTOCOL  *FormBrowserEx2;
+
+  Status = gBS->LocateProtocol (&gEdkiiFormBrowserEx2ProtocolGuid, NULL, (VOID **)&FormBrowserEx2);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  //
+  // The browser keeps a copy of the help and will not take a key twice, so
+  // drop what an earlier call registered before registering it again.
+  //
+  HotKey.UnicodeChar = CHAR_NULL;
+  HotKey.ScanCode    = SCAN_F10;
+  FormBrowserEx2->RegisterHotKey (&HotKey, BROWSER_ACTION_UNREGISTER, 0, NULL);
+  NewString = HiiGetString (gHiiHandle, STRING_TOKEN (FUNCTION_TEN_STRING), NULL);
+  ASSERT (NewString != NULL);
+  if (NewString != NULL) {
+    FormBrowserEx2->RegisterHotKey (&HotKey, BROWSER_ACTION_SUBMIT, 0, NewString);
+    FreePool (NewString);
+  }
+
+  HotKey.ScanCode = SCAN_F9;
+  FormBrowserEx2->RegisterHotKey (&HotKey, BROWSER_ACTION_UNREGISTER, 0, NULL);
+  NewString = HiiGetString (gHiiHandle, STRING_TOKEN (FUNCTION_NINE_STRING), NULL);
+  ASSERT (NewString != NULL);
+  if (NewString != NULL) {
+    FormBrowserEx2->RegisterHotKey (&HotKey, BROWSER_ACTION_DEFAULT, EFI_HII_DEFAULT_CLASS_STANDARD, NewString);
+    FreePool (NewString);
+  }
+}
+
+//
+// The PlatformLang the display strings were last taken in.
+//
+STATIC CHAR8  mDisplayStringsLanguage[64];
+
+/**
+  Take the display strings again if PlatformLang changed since they were taken.
+
+  They are looked up once and kept, so without this a language picked in the
+  front page would only reach the pop-ups and the F9/F10 help after a reboot.
+  The browser copies the hot key help into each form before showing it, so
+  the new help shows from the next form on.
+
+**/
+STATIC
+VOID
+RefreshDisplayStrings (
+  VOID
+  )
+{
+  CHAR8       Language[64];
+  UINTN       Size;
+  EFI_STATUS  Status;
+
+  ZeroMem (Language, sizeof (Language));
+  Size   = sizeof (Language) - 1;
+  Status = gRT->GetVariable (L"PlatformLang", &gEfiGlobalVariableGuid, NULL, &Size, Language);
+  if (EFI_ERROR (Status) || (AsciiStrCmp (Language, mDisplayStringsLanguage) == 0)) {
+    return;
+  }
+
+  AsciiStrCpyS (mDisplayStringsLanguage, sizeof (mDisplayStringsLanguage), Language);
+  FreeDisplayStrings ();
+  InitializeDisplayStrings ();
+  RegisterDefaultHotKeys ();
+}
+
