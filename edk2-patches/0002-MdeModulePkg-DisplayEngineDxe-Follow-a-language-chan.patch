diff --git a/MdeModulePkg/Library/CustomizedDisplayLib/CustomizedDisplayLibInternal.c b/MdeModulePkg/Library/CustomizedDisplayLib/CustomizedDisplayLibInternal.c
index 21e7e87c94..f0ca05d810 100644
--- a/MdeModulePkg/Library/CustomizedDisplayLib/CustomizedDisplayLibInternal.c
+++ b/MdeModulePkg/Library/CustomizedDisplayLib/CustomizedDisplayLibInternal.c
@@ -780,6 +780,39 @@ FreeLibStrings (
   FreePool (mSpaceBuffer);
 }
 
+//
+// The PlatformLang the library strings were last taken in.
+//
+STATIC CHAR8  mLibStringsLanguage[64];
+
+/**
+  Take the library strings again if PlatformLang changed since they were taken.
+
+  They are looked up once and kept, so without this a language picked in the
+  front page would only reach the key help after a reboot.
+
+**/
+VOID
+RefreshLibStrings (
+  VOID
+  )
+{
+  CHAR8       Language[64];
+  UINTN       Size;
+  EFI_STATUS  Status;
+
+  ZeroMem (Language, sizeof (Language));
+  Size   = sizeof (Language) - 1;
+  Status = gRT->GetVariable (L"PlatformLang", &gEfiGlobalVariableGuid, NULL, &Size, Language);
+  if (EFI_ERROR (Status) || (AsciiStrCmp (Language, mLibStringsLanguage) == 0)) {
+    return;
+  }
+
+  AsciiStrCpyS (mLibStringsLanguage, sizeof (mLibStringsLanguage), Language);
+  FreeLibStrings ();
+  InitializeLibStrings ();
+}
+
