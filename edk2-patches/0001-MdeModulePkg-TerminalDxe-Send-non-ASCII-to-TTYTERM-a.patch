From d78eaa12000cb6539bceba17df17bf44c9d79769 Mon Sep 17 00:00:00 2001
From: Eric Wu <eric3u@outlook.com>
Date: Tue, 29 Sep 2026 22:28:15 +0800
Subject: [PATCH 1/9] MdeModulePkg/TerminalDxe: Send non-ASCII to TTYTERM as
 UTF-8

A tty is a UTF-8 terminal, but TtyTerm shares the ANSI output path, which
turns anything that is neither ASCII nor box drawing into a '?'. Worse, it
does so by truncating the character to CHAR8 first and checking what is
left, so a CJK character whose low byte happens to be printable comes out
as that byte instead: U+4E2D prints as '-'. A menu in Chinese is garbage.

Send such characters to TtyTerm as UTF-8, and let TestString() report
them as supported like it does for VT-UTF8.

That alone would put the cursor in the wrong place. The driver assumes
every character advances it by one column, while the terminal emulator
gives a CJK character two, and TtyTerm moves the cursor relative to where
the driver believes it is. Advance by two for the characters terminal
emulators treat as double width, the BMP ranges with East Asian Width W
or F, both here and for VT-UTF8, which has always had the same drift.

Signed-off-by: Eric Wu <eric3u@outlook.com>
---
 .../Universal/Console/TerminalDxe/Terminal.h  | 14 +++
 .../Console/TerminalDxe/TerminalConOut.c      | 94 ++++++++++++++++++-
 2 files changed, 105 insertions(+), 3 deletions(-)

diff --git a/MdeModulePkg/Universal/Console/TerminalDxe/Terminal.h b/MdeModulePkg/Universal/Console/TerminalDxe/Terminal.h
index 04fb2e5d71..2ec7e7b818 100644
--- a/MdeModulePkg/Universal/Console/TerminalDxe/Terminal.h
+++ b/MdeModulePkg/Universal/Console/TerminalDxe/Terminal.h
@@ -1412,6 +1412,20 @@ TerminalIsValidEfiCntlChar (
   IN  CHAR16  CharC
   );
 
+/**
+  Detects if a character takes two columns on a terminal emulator.
+
+  @param  Char         Unicode char to test.
+
+  @retval TRUE         If Char is double width.
+  @retval FALSE        If Char is single width.
+
+**/
+BOOLEAN
+TerminalIsWideChar (
+  IN  CHAR16  Char
+  );
+
 /**
   Check if the device supports hot-plug through its device path.
 
diff --git a/MdeModulePkg/Universal/Console/TerminalDxe/TerminalConOut.c b/MdeModulePkg/Universal/Console/TerminalDxe/TerminalConOut.c
index 10d6695397..40f13df16c 100644
--- a/MdeModulePkg/Universal/Console/TerminalDxe/TerminalConOut.c
+++ b/MdeModulePkg/Universal/Console/TerminalDxe/TerminalConOut.c
@@ -185,6 +185,7 @@ TerminalConOutOutputString (
   EFI_STATUS                   Status;
   UINT8                        ValidBytes;
   CHAR8                        CrLfStr[2];
+  UINTN                        Width;
   //
   //  flag used to indicate whether condition happens which will cause
   //  return EFI_WARN_UNKNOWN_GLYPH
@@ -224,6 +225,13 @@ TerminalConOutOutputString (
       continue;
     }
 
+    //
+    // How many columns the terminal will advance by. A character sent as
+    // itself takes as many as the terminal emulator gives it, which for CJK
+    // is two; one squashed into ASCII takes one.
+    //
+    Width = 1;
+
     switch (TerminalDevice->TerminalType) {
       case TerminalTypePcAnsi:
       case TerminalTypeVt100:
@@ -234,6 +242,33 @@ TerminalConOutOutputString (
       case TerminalTypeVt400:
       case TerminalTypeSCO:
 
+        if ((TerminalDevice->TerminalType == TerminalTypeTtyTerm) &&
+            (*WString > 0x7F) &&
+            !TerminalIsValidTextGraphics (*WString, NULL, NULL))
+        {
+          //
+          // A tty speaks UTF-8. Send it anything the ASCII fallback below
+          // would turn into a '?', or into whatever its low byte happens to
+          // be, as the character itself.
+          //
+          UnicodeToUtf8 (*WString, &Utf8Char, &ValidBytes);
+          Length = ValidBytes;
+          Status = TerminalDevice->SerialIo->Write (
+                                               TerminalDevice->SerialIo,
+                                               &Length,
+                                               (UINT8 *)&Utf8Char
+                                               );
+          if (EFI_ERROR (Status)) {
+            goto OutputError;
+          }
+
+          if (TerminalIsWideChar (*WString)) {
+            Width = 2;
+          }
+
+          break;
+        }
+
         if (!TerminalIsValidTextGraphics (*WString, &GraphicChar, &AsciiChar)) {
           //
           // If it's not a graphic character convert Unicode to ASCII.
@@ -287,6 +322,10 @@ TerminalConOutOutputString (
           goto OutputError;
         }
 
+        if (TerminalIsWideChar (*WString)) {
+          Width = 2;
+        }
+
         break;
     }
 
@@ -313,8 +352,8 @@ TerminalConOutOutputString (
         break;
 
       default:
-        if (Mode->CursorColumn < (INT32)(MaxColumn - 1)) {
-          Mode->CursorColumn++;
+        if ((UINTN)Mode->CursorColumn + Width < MaxColumn) {
+          Mode->CursorColumn += (INT32)Width;
         } else {
           Mode->CursorColumn = 0;
           if (Mode->CursorRow < (INT32)(MaxRow - 1)) {
@@ -403,7 +442,6 @@ TerminalConOutTestString (
     case TerminalTypePcAnsi:
     case TerminalTypeVt100:
     case TerminalTypeVt100Plus:
-    case TerminalTypeTtyTerm:
     case TerminalTypeLinux:
     case TerminalTypeXtermR6:
     case TerminalTypeVt400:
@@ -411,6 +449,11 @@ TerminalConOutTestString (
       Status = AnsiTestString (TerminalDevice, WString);
       break;
 
+    //
+    // A tty gets anything that is not ASCII or box drawing in UTF-8, so it
+    // can render as much as VT-UTF8 can.
+    //
+    case TerminalTypeTtyTerm:
     case TerminalTypeVtUtf8:
       Status = VTUTF8TestString (TerminalDevice, WString);
       break;
@@ -953,6 +996,51 @@ TerminalIsValidAscii (
   return FALSE;
 }
 
+/**
+  Detects if a character takes two columns on a terminal emulator.
+
+  These are the BMP ranges whose Unicode East Asian Width is W or F, which
+  is what terminal emulators go by. The display engine goes by the \wide
+  markers in its strings instead, and strings are marked up by the same
+  table, so the two agree on where the cursor ends up.
+
+  @param  Char         Unicode char to test.
+
+  @retval TRUE         If Char is double width.
+  @retval FALSE        If Char is single width.
+
+**/
+BOOLEAN
+TerminalIsWideChar (
+  IN  CHAR16  Char
+  )
+{
+  STATIC CONST CHAR16  WideRanges[][2] = {
+    { 0x1100, 0x115F },   // Hangul Jamo initial consonants
+    { 0x2E80, 0x303E },   // CJK radicals, symbols and punctuation
+    { 0x3041, 0x33FF },   // Kana, Bopomofo, Hangul compatibility Jamo, CJK compatibility
+    { 0x3400, 0x4DBF },   // CJK Unified Ideographs Extension A
+    { 0x4E00, 0x9FFF },   // CJK Unified Ideographs
+    { 0xA000, 0xA4CF },   // Yi
+    { 0xA960, 0xA97F },   // Hangul Jamo Extended-A
+    { 0xAC00, 0xD7A3 },   // Hangul syllables
+    { 0xF900, 0xFAFF },   // CJK Compatibility Ideographs
+    { 0xFE10, 0xFE19 },   // Vertical forms
+    { 0xFE30, 0xFE6F },   // CJK compatibility forms, small form variants
+    { 0xFF00, 0xFF60 },   // Fullwidth ASCII variants
+    { 0xFFE0, 0xFFE6 },   // Fullwidth symbol variants
+  };
+  UINTN                Index;
+
+  for (Index = 0; Index < ARRAY_SIZE (WideRanges); Index++) {
+    if ((Char >= WideRanges[Index][0]) && (Char <= WideRanges[Index][1])) {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
 /**
   Detects if a valid EFI control character.
 
-- 
2.43.0

