+/**
+  Set a string to the text of another, one language at a time.
+
+  HiiSetString() without a language puts the same text in every language,
+  which for words the user reads means the same language in all of them.
+
+  @param[in]    HiiHandle           The package list the strings are in.
+  @param[in]    Target              The string to set.
+  @param[in]    Source              The string to take the text from.
+
+**/
+STATIC
+VOID
+SetStringFromString (
+  IN EFI_HII_HANDLE  HiiHandle,
+  IN EFI_STRING_ID   Target,
+  IN EFI_STRING_ID   Source
+  )
+{
+  CHAR8       *Languages;
+  CHAR8       *Language;
+  CHAR8       *Next;
+  EFI_STRING  String;
+
+  Languages = HiiGetSupportedLanguages (HiiHandle);
+  if (Languages == NULL) {
+    return;
+  }
+
+  for (Language = Languages; *Language != '\0'; Language = Next) {
+    for (Next = Language; (*Next != '\0') && (*Next != ';'); Next++) {
+    }
+
+    if (*Next == ';') {
+      *Next++ = '\0';
+    }
+
+    String = HiiGetString (HiiHandle, Source, Language);
+    if (String != NULL) {
+      HiiSetString (HiiHandle, Target, String, Language);
+      FreePool (String);
+    }
+  }
+
+  FreePool (Languages);
+}
+
+/**
+  Show a pop-up made of this driver's strings, in the current language, and
+  wait for a key.
+
+  @param[in]    Private             Module's private data.
+  @param[out]   Key                 The key the pop-up was dismissed with.
+  @param[in]    Line1               The first line.
+  @param[in]    Line2               The second line, or 0 for none.
+
+**/
+STATIC
+VOID
+SecureBootPopUp (
+  IN  SECUREBOOT_CONFIG_PRIVATE_DATA  *Private,
+  OUT EFI_INPUT_KEY                   *Key,
+  IN  EFI_STRING_ID                   Line1,
+  IN  EFI_STRING_ID                   Line2
+  )
+{
+  EFI_STRING  String1;
+  EFI_STRING  String2;
+
+  Key->ScanCode    = SCAN_NULL;
+  Key->UnicodeChar = CHAR_NULL;
+
+  String1 = HiiGetString (Private->HiiHandle, Line1, NULL);
+  String2 = (Line2 != 0) ? HiiGetString (Private->HiiHandle, Line2, NULL) : NULL;
+
+  if (String1 != NULL) {
+    CreatePopUp (EFI_LIGHTGRAY | EFI_BACKGROUND_BLUE, Key, String1, String2, NULL);
+    FreePool (String1);
+  }
+
+  if (String2 != NULL) {
+    FreePool (String2);
+  }
+}
