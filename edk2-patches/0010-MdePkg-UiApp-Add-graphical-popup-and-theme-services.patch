+#string STR_FLANGE_THEME_HELP #language en-US "Choose Field, Terminal, Paper, Wartime, or the original HII interface."
+                             #language zh-Hans "\wide选择\narrow Field\wide、\narrowTerminal\wide、\narrowPaper\wide、\narrowWartime \wide或原版\narrow HII \wide界面。\narrow"
